          }
        }
      }
    },
    "/comment": {
      "get": {
        "summary": "PR comment message",
        "description": "Get PR comment contents for the difference between two builds.\n\n _Note: Formerly `/getComment`, usages of `/getComment` are still supported but will be deprecated in the future._",
        "parameters": [
          {
            "name": "buildId",
            "in": "query",
            "description": "Build id (aka head SHA) of the latest build with your changes. This is the same id passed to the Fastlane upload.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "baseBuildId",
            "in": "query",
            "description": "Build id (aka base SHA) to compare your build with. This is the same id passed to the Fastlane upload.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentData"
                }
              }
            }
          }
        }
      }
    },
    "/deadCode/export": {
      "post": {
        "summary": "Export Reaper analysis results",
        "description": "Returns the Reaper analysis results for a given build. You can identify the build using either an uploadId OR a combination of platform, appId, and version.",
        "parameters": [
          {
            "name": "uploadId",
            "in": "query",
            "description": "The Emerge ID of the build to analyze. Required if not using platform+appId+version combination.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "description": "The platform of the app ('ios' or 'android'). Required if not using uploadId.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            }
          },
          {
            "name": "appId",
            "in": "query",
            "description": "The bundle ID or package name of the app. Required if not using uploadId.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "description": "The version of the app. Required if not using uploadId.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The current page to request data for in the event of pagination. Defaults to 1 if not specified.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaperExportResponse"
                }
              }
            }
          }
        }
      }
    },
    "/getPerfTest": {
      "get": {
        "summary": "Get performance test results",
        "description": "Given a test ID, get the performance test results for it",
        "parameters": [
          {
            "name": "testId",
            "in": "query",
            "description": "The test ID, which is returned for example, as the test_id field from /runPerfTest",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "The status of the test. Note that `performanceTests` will be empty until the status is DONE.",
                      "enum": [
                        "PROCESSING",
                        "DONE"
                      ]
                    },
                    "headId": {
                      "type": "string",
                      "description": "The Emerge Id of the head build"
                    },
                    "baseId": {
                      "type": "string",
                      "description": "The Emerge Id of the base build"
                    },
                    "performanceTests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PerfTestData"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trace": {
      "post": {
        "summary": "Request a signed URL for downloading a trace",
        "description": "Creates a URL for downloading the trace associated with a particular iteration of a performance test span (if available).",
        "requestBody": {
          "description": "The trace to download.",
          "required": true,
          "content": {
            "*/*": {
              "schema": {
                "type": "object",
                "properties": {
                  "spanId": {
                    "type": "string",
                    "description": "The id of the span, e.g. `span_Ab24Sn1Ao00`."
                  },
                  "iteration": {
                    "type": "number",
                    "description": "The iteration requested, e.g. `42`"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceDownload"
                }
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "summary": "Request a signed URL for upload",
        "description": "Creates a new upload and returns a signed URL to send the upload data.",
        "requestBody": {
          "description": "The upload to create",
          "content": {
            "*/*": {
              "schema": {
                "type": "object",
                "properties": {
                  "prNumber": {
                    "type": "string",
                    "description": "For branch builds only. The PR number associated with this build, e.g. `123`."
                  },
                  "branch": {
                    "type": "string",
                    "description": "For branch builds only. The branch name associated with this build, e.g. `main` or `feature/1234`."
                  },
                  "sha": {
                    "type": "string",
                    "description": "The Git SHA of the commit associated with this build."
                  },
                  "baseSha": {
                    "type": "string",
                    "description": "For branch builds only. The Git SHA of the base commit associated with this build, i.e. the commit you branched off of."
                  },
                  "repoName": {
                    "type": "string",
                    "description": "The name of the repository associated with this build, e.g. `EmergeTools/hackernews`."
                  },
                  "gitlabProjectId": {
                    "type": "string"
                  },
                  "tag": {
                    "type": "string",
                    "description": "A tag label to associate with this build. This is useful for grouping builds together, e.g. `release`, `debug`, or `pull-request`."
                  },
                  "filename": {
                    "type": "string",
                    "deprecated": true,
                    "description": "This field is no longer used."
                  },
                  "buildType": {
                    "type": "string",
                    "default": "release",
                    "deprecated": true,
                    "description": "This field has been renamed to `tag`."
                  },
                  "appIdSuffix": {
                    "type": "string",
                    "description": "A suffix to append to the application ID to differentiate between different builds of the same app, not applicable for Android."
                  },
                  "releaseNotes": {
                    "type": "string",
                    "description": "A markdown string with release notes for the upload"
                  },
                  "orderFileVersion": {
                    "type": "string",
                    "description": "The version number is used as a key to retrieve the order file after it generates. For most apps, the easiest way to choose an order file version is to simply set it to the version of your app."
                  }
                }
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUpload"
                }
              }
            }
          }
        },
        "x-codegen-request-body-name": "upload"
      }
    },
