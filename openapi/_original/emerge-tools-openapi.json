{
  "openapi": "3.1.0",
  "info": {
    "title": "Emerge API",
    "description": "The Emerge API allows you to access app size data for individual builds, including breakdowns of size by Swift module, framework, and Obj-C prefix.",
    "version": "0.2.0",
    "x-apievangelist": {
      "generated": "2026-07-19",
